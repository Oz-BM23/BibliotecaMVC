@{
    ViewData["Title"] = "Inicio";
}

<div class="py-5 bg-light rounded-3 mb-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-7">
                <h1 class="display-5 fw-bold">Biblioteca MVC</h1>
                <p class="col-md-10 fs-5 text-muted">Explora nuestra colección de libros, descubre autores destacados, consulta categorías y accede a los servicios bibliotecarios en línea.</p>
            </div>
            <div class="col-md-5 text-center">
                <img src="https://picsum.photos/id/24/900/350" alt="Biblioteca" class="img-fluid" style="max-height:220px;" />
            </div>
        </div>
    </div>
</div>

<div class="row gy-4 mb-4">
    <div class="col-md-3">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Libros</h5>
                <p class="card-text text-muted">Consulta, reserva y descarga recursos digitales.</p>
                <a class="btn btn-outline-primary mt-2" href="/Libros">Ver libros</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Autores</h5>
                <p class="card-text text-muted">Biografías y obras destacadas de autores.</p>
                <a class="btn btn-outline-primary mt-2" href="/Autores">Ver autores</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Categorías</h5>
                <p class="card-text text-muted">Navega por géneros y materias.</p>
                <a class="btn btn-outline-primary mt-2" href="/Home/Categorias">Ver categorías</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Acerca de</h5>
                <p class="card-text text-muted">Descubre quienes somos.</p>
                <a class="btn btn-outline-primary mt-2" href="/Home/About">Ver servicios</a>
            </div>
        </div>
    </div>
</div>

<section class="container mt-4">
    <h2 class="h4 mb-3">Biblioteca Virtual</h2>
    <div class="virtual-library-grid">
        <div class="grid-featured">
            <h3 class="h5">Libros destacados</h3>
            <div class="d-flex gap-3 align-items-start mb-3">
                <img src="https://picsum.photos/seed/book1/160/220" alt="Libro destacado" class="img-thumbnail" style="width:120px;height:auto;" />
                <div>
                    <h5 class="mb-1">Cien Años de Soledad</h5>
                    <p class="text-muted mb-1">Autor: Gabriel García Márquez</p>
                    <p class="text-muted small">Una novela para avidos lectores. Disponible en préstamo digital y lectura en línea.</p>
                    <a class="btn btn-sm btn-primary" href="/Libros/Details/1">Ver detalles</a>
                </div>
            </div>
            <hr />
            <h6 class="mb-2">Más destacados</h6>
            <ul class="list-unstyled mb-0">
                <li class="py-1"><a href="/Libros/Details/2">Novela histórica — Miguel de Cervantes</a></li>
                <li class="py-1"><a href="/Libros/Details/3">Infantil — Antoine de Saint-Exupéry</a></li>
                <li class="py-1"><a href="/Libros/Details/4">Ciencia ficcion — George Orwell</a></li>
            </ul>
        </div>
        <div class="grid-list">
            <div class="grid-card">
                <h4 class="h6">Servicios</h4>
                <p class="small text-muted">Préstamo digital, reservas, consultas bibliográficas y ayuda en línea.</p>
                <a href="/Home/Préstamos" class="btn btn-sm btn-outline-secondary">Conoce los servicios</a>
            </div>
        </div>
    </div>
</section>
