@model BibliotecaMVC.Models.Autor

@{
    ViewData["Title"] = "Eliminar autor";
}

<h2>@ViewData["Title"]</h2>

<h3>¿Está seguro que desea eliminar este autor?</h3>

<div>
    <h4>Autor</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Nombre
        </dt>
        <dd class = "col-sm-10">
            @Model.Nombre
        </dd>
        <dt class = "col-sm-2">
            Apellido
        </dt>
        <dd class = "col-sm-10">
            @Model.Apellido
        </dd>
        <dt class = "col-sm-2">
            Nacionalidad
        </dt>
        <dd class = "col-sm-10">
            @Model.Nacionalidad
        </dd>
        <dt class = "col-sm-2">
            Fecha de nacimiento
        </dt>
        <dd class = "col-sm-10">
            @Model.FechaNacimiento.ToShortDateString()
        </dd>
        <dt class = "col-sm-2">
            Activo
        </dt>
        <dd class = "col-sm-10">
            @(Model.Activo ? "Sí" : "No")
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
