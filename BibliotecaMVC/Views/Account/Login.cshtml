@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<h1>Iniciar sesión</h1>

<div class="col-md-6">
    <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="NameorEmail" class="form-label"></label>
            <input asp-for="NameorEmail" class="form-control" autocomplete="username" />
            <span asp-validation-for="NameorEmail" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="username" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary">Iniciar sesión</button>
        <a asp-action="Register" class="btn btn-secondary">Crear Una Cuenta</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}