@model dynamic
<div class="info-card">
    <div class="info-card-body">
        <h4 class="mb-1">@Model.Title</h4>
        <p class="text-muted mb-2">@Model.Description</p>
        @if(Model?.Link != null)
        {
            <a class="btn btn-sm btn-outline-primary" href="@Model.Link">@((Model?.LinkText) ?? "Ver")</a>
        }
    </div>
</div>
