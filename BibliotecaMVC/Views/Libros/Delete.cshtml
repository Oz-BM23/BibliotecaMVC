@model BibliotecaMVC.Models.Libro

@{
    ViewData["Title"] = "Eliminar libro";
}

<h2>@ViewData["Title"]</h2>

<h3>¿Está seguro que desea eliminar este libro?</h3>

<div>
    <h4>Libro</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Título
        </dt>
        <dd class = "col-sm-10">
            @Model.Titulo
        </dd>
        <dt class = "col-sm-2">
            Autor
        </dt>
        <dd class = "col-sm-10">
            @Model.Autor
        </dd>
        <dt class = "col-sm-2">
            Categoría
        </dt>
        <dd class = "col-sm-10">
            @Model.Categoria
        </dd>
        <dt class = "col-sm-2">
            Precio
        </dt>
        <dd class = "col-sm-10">
            @Model.Precio.ToString("C")
        </dd>
        <dt class = "col-sm-2">
            Disponible
        </dt>
        <dd class = "col-sm-10">
            @(Model.Disponible ? "Sí" : "No")
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
